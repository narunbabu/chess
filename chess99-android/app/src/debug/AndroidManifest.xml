<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Debug-only override: allows plain HTTP to the local dev backend
         (10.0.2.2, the emulator's alias for the host machine) so this
         build variant can be tested against `php artisan serve` without
         touching the release manifest, which stays HTTPS-only. -->
    <application
        android:usesCleartextTraffic="true" />

</manifest>
