[
  {
    "section": "Move classification labels (resource ids on the domain enum)",
    "file": "domain/model/MoveAnalysis.kt",
    "strings": {
      "move_class_brilliant": "Brilliant",
      "move_class_excellent": "Excellent",
      "move_class_good": "Good",
      "move_class_inaccuracy": "Inaccuracy",
      "move_class_mistake": "Mistake",
      "move_class_blunder": "Blunder",
      "move_class_book": "Book"
    },
    "edits": [
      [
        "package com.chess99.domain.model\n",
        "package com.chess99.domain.model\n\nimport com.chess99.R\n"
      ],
      [
        "enum class MoveClassification(val icon: String, val label: String) {\n    BRILLIANT(\"★\", \"Brilliant\"),\n    EXCELLENT(\"⭐\", \"Excellent\"),\n    GOOD(\"✓\", \"Good\"),\n    INACCURACY(\"?!\", \"Inaccuracy\"),\n    MISTAKE(\"?\", \"Mistake\"),\n    BLUNDER(\"??\", \"Blunder\"),\n    BOOK(\"📗\", \"Book\"),\n}",
        "/** `icon` is a glyph, not copy; the label is a string resource. */\nenum class MoveClassification(\n    val icon: String,\n    @androidx.annotation.StringRes val labelRes: Int,\n) {\n    BRILLIANT(\"★\", R.string.move_class_brilliant),\n    EXCELLENT(\"⭐\", R.string.move_class_excellent),\n    GOOD(\"✓\", R.string.move_class_good),\n    INACCURACY(\"?!\", R.string.move_class_inaccuracy),\n    MISTAKE(\"?\", R.string.move_class_mistake),\n    BLUNDER(\"??\", R.string.move_class_blunder),\n    BOOK(\"📗\", R.string.move_class_book),\n}"
      ]
    ]
  },
  {
    "section": "Lifeline markers",
    "file": "presentation/history/LifelineMarkers.kt",
    "strings": {
      "lifeline_best": "Best",
      "lifeline_undo": "Undo",
      "lifeline_review": "Review",
      "lifeline_help": "Help"
    },
    "edits": [
      [
        "    fun label(marker: String): String = when (marker.lowercase()) {\n        \"best-move\", \"best_move\", \"best\" -> \"Best\"\n        \"undo\" -> \"Undo\"\n        \"review\" -> \"Review\"\n        else -> \"Help\"\n    }",
        "    @androidx.annotation.StringRes\n    fun labelRes(marker: String): Int = when (marker.lowercase()) {\n        \"best-move\", \"best_move\", \"best\" -> R.string.lifeline_best\n        \"undo\" -> R.string.lifeline_undo\n        \"review\" -> R.string.lifeline_review\n        else -> R.string.lifeline_help\n    }"
      ]
    ]
  },
